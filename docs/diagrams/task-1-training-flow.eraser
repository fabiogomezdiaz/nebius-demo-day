typeface:clean
colorMode:pastel
styleMode:plain

title Task 1 — sbatch torchrun LoRA SFT
autoNumber nested

ws [label: "Operator workstation", icon: monitor, color: green]
login [label: "login-0 (SSH)", icon: terminal, color: blue]
ctld [label: "slurmctld", icon: server, color: blue]
w0 [label: "worker-0 (1xH100)", icon: cpu, color: orange]
w1 [label: "worker-1 (1xH100)", icon: cpu, color: orange]
data [label: "/mnt/data filestore", icon: hard-drive, color: gray]

ws > login: SSH via 05-login.sh
activate login
ws > data: 04-sync rsyncs workloads/ to /mnt/data/nebius-demo
login > data: setup_env.sh creates shared venv
ws > login: sbatch train.sbatch
login > ctld: Allocate 2 nodes x 1 GPU
activate ctld
ctld > w0: srun torchrun rank 0
ctld > w1: srun torchrun rank 1
deactivate ctld
w0 <> w1: Exchange NCCL gradients over Ethernet (NCCL_IB_DISABLE=1, NCCL_NET=Socket)
w0 > data: Write LoRA adapters to checkpoints/helios-lora
data --> login: Job complete
deactivate login
